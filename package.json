    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "prisma": "^6.12.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
