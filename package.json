{
  "name": "ingrefit-web",
  "version": "1.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:landing": "node scripts/validate-landing.mjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "test:scoring": "tsx scripts/scoring-cases.ts",
    "off:full": "./scripts/off-cron.sh full",
    "off:delta": "./scripts/off-cron.sh delta",
    "i18n:status": "node scripts/i18n-status.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "next": "16.3.1",
    "next-intl": "4.13.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.12.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.18.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
