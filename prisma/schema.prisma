// IngreFit persistence layer.
//
// PostgreSQL is used because the same instance later hosts the imported
// Open Food Facts dataset (see docs/DATABASE.md). Everything in this file is a
// cache or a counter: no user account, no scan history and no photo is stored
// server-side, so a full wipe only costs money in re-generated Gemini calls.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Normalized product facts keyed by barcode.
/// `facts` holds the RAW Open Food Facts product record as returned by the API,
/// not a normalized ProductFacts value: normalization is cheap, deterministic
/// and locale-dependent, so it is redone per request by
/// `openFoodFacts.productFactsFromRaw`. Localized user-facing strings live in
/// ProductLocalization.
model ProductCache {
  barcode     String   @id
  facts       Json
  fetchedAt   DateTime @default(now())
  refreshedAt DateTime @updatedAt

  localizations ProductLocalization[]

  @@index([refreshedAt])
}

/// Translated user-facing strings for one product in one language.
/// Saves one Gemini call per Premium scan of an already-seen product.
model ProductLocalization {
  barcode   String
  language  String
  strings   Json
  createdAt DateTime @default(now())

  product ProductCache @relation(fields: [barcode], references: [barcode], onDelete: Cascade)

  @@id([barcode, language])
}

/// Generated explanation keyed by the deterministic signal fingerprint.
/// Identical signal sets in the same language reuse the same text, so popular
/// products converge to zero explanation cost.
model ExplanationCache {
  fingerprint String   @id
  language    String
  payload     Json
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @updatedAt

  @@index([lastUsedAt])
}

/// Products contributed by users, stored beside the Open Food Facts mirror.
///
/// `data` deliberately uses the SAME field names as an Open Food Facts record
/// (`product_name`, `ingredients_text`, `categories_tags`, `nutriments`, …).
/// That single decision is what keeps the rest of the system unchanged: the
/// existing normalizer, category extraction, market gate, scorer and
/// recommendation SQL all read a community record without knowing it is one.
///
/// Rows are created server-side when a label scan resolves a barcode that no
/// Open Food Facts source knew, so app builds that predate this feature start
/// contributing without an update.
model CommunityProduct {
  barcode String @id

  /// Open-Food-Facts-shaped record. See lib/ingrefit/community.ts.
  data Json

  /// published — served to everyone. hidden — kept but never served.
  /// pending — awaiting review; served only if COMMUNITY_AUTOPUBLISH is on.
  status String @default("published")

  /// Recognition confidence reported by the model, 0..1.
  confidence Float @default(0)

  /// Installation that contributed it. Not shown anywhere; used to rate-limit
  /// abuse and to remove everything from one bad actor at once.
  contributorId String

  /// Denormalized so the admin list can sort and search without opening JSON.
  name   String?
  brands String?

  /// Relative path of the stored front-photo thumbnail, served by
  /// /api/ingrefit/community-image.
  imagePath String?

  /// How many times this record has been served. A popular record deserves
  /// review before an unpopular one.
  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([contributorId])
  @@index([name])
  @@index([brands])
}

/// Per-installation shared secret, registered once at first launch.
///
/// The installation id travels in every request header, so on its own it is a
/// bearer credential: anyone who saw it could be served as that subscriber.
/// The secret never leaves the device after registration; requests carry a
/// signature over it instead. See lib/ingrefit/installation.ts.
model Installation {
  id         String   @id
  secret     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([lastSeenAt])
}

/// Fixed-window request counters. One row per (scope, key, window).
model RateLimitWindow {
  id          String   @id
  scope       String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@index([expiresAt])
}

/// Optional local mirror of the Open Food Facts dataset.
/// Populated by `scripts/import-openfoodfacts.mjs`. When present and enabled by
/// OPEN_FOOD_FACTS_LOCAL=true, barcode lookups never leave the server, which
/// removes the upstream rate limit from the critical path entirely.
///
/// The dataset is licensed under the Open Database License (ODbL). Attribution
/// and the share-alike obligation apply to anything derived from it.
model OffProduct {
  barcode      String   @id
  data         Json
  lastModified DateTime
  importedAt   DateTime @default(now())

  @@index([lastModified])
}
