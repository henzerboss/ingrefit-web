# Gemini (same REST pattern as evsi.store)
GEMINI_API_KEY=replace-me
INGREFIT_GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite

# App update prompt. Raise LATEST when the new store build is available.
# Raise MINIMUM only when an old build must no longer be used.
INGREFIT_IOS_LATEST_VERSION=1.6.0
INGREFIT_IOS_MINIMUM_VERSION=1.0.0
INGREFIT_ANDROID_LATEST_VERSION=1.6.0
INGREFIT_ANDROID_MINIMUM_VERSION=1.0.0

# A comma-separated allowlist. The Expo app sends one as Bearer token.
INGREFIT_CLIENT_TOKENS=replace-with-a-long-random-token

# Required by Open Food Facts. Include a real contact address or web page.
OPEN_FOOD_FACTS_USER_AGENT=IngreFit/1.0 (https://ingrefit.com; support@evsi.store)

# RevenueCat secret key for server-side entitlement verification.
REVENUECAT_SECRET_API_KEY=sk_replace_me
REVENUECAT_ENTITLEMENT_ID=premium

# Signs the short-lived Premium entitlement issued by /api/ingrefit/entitlement.
# Required in production: without it every request falls back to a live
# RevenueCat lookup. Generate once with: openssl rand -base64 48
INGREFIT_ENTITLEMENT_SECRET=replace-with-at-least-32-random-bytes

# Refuse Premium for a registered installation that does not sign its requests.
# Leave false until no unsigned build is left in the wild, then set to true.
INGREFIT_REQUIRE_INSTALLATION_PROOF=false

# Expo Go/local preview only. This deliberately trusts the client plan; disable before distribution.
INGREFIT_ALLOW_DEMO_PREMIUM=false

# Optional Expo Go preview only. Use this same value as EXPO_PUBLIC_CLIENT_TOKEN while testing,
# then remove it before distributing the app.
INGREFIT_EXPO_GO_PREVIEW_TOKEN=

# ---------------------------------------------------------------------------
# Database (PostgreSQL). Product cache, translation cache, explanation cache and
# rate-limit counters live here. The API keeps working without it, just at full
# Gemini cost and with in-memory rate limiting only.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ingrefit:replace-me@127.0.0.1:5432/ingrefit?schema=public

# How long a cached Open Food Facts record stays fresh before it is re-fetched.
INGREFIT_PRODUCT_CACHE_DAYS=30

# ---------------------------------------------------------------------------
# Rate limits (requests per hour). Sized for real shopping behaviour; lower them
# if abuse appears in the logs.
# ---------------------------------------------------------------------------
INGREFIT_LIMIT_ANALYZE_FREE=120
INGREFIT_LIMIT_ANALYZE_PREMIUM=300
INGREFIT_LIMIT_AI_FREE=10
INGREFIT_LIMIT_AI_PREMIUM=60
INGREFIT_LIMIT_ANALYZE_IP=600
INGREFIT_LIMIT_RECOMMENDATIONS_PREMIUM=300
INGREFIT_LIMIT_RECOMMENDATIONS_IP=900
INGREFIT_LIMIT_USAGE=120
INGREFIT_LIMIT_USAGE_IP=600
INGREFIT_LIMIT_INSTALLATION_IP=30

# Secret used to hash caller IP addresses before they are used as rate-limit
# keys, so no raw address is ever stored. Generate once with:
#   openssl rand -base64 32
INGREFIT_IP_HASH_SECRET=

# ---------------------------------------------------------------------------
# Open Food Facts self-hosting (see docs/DATABASE.md).
# LOCAL=true  -> barcode lookups read the imported dataset first.
# LOCAL_ONLY=true -> never fall back to the public API on a miss.
# ---------------------------------------------------------------------------
OPEN_FOOD_FACTS_LOCAL=false
OPEN_FOOD_FACTS_LOCAL_ONLY=false
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# Importer settings. OFF_IMPORT_DIR must be writable by the user that runs the
# cron job (on a panel-managed server that is the site user, not root).
OFF_IMPORT_DIR=/home/ingrefit/off-data
OFF_IMPORT_BATCH=2000
OFF_FULL_EXPORT_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
OFF_DELTA_INDEX_URL=https://static.openfoodfacts.org/data/delta/index.txt
OFF_DELTA_BASE_URL=https://static.openfoodfacts.org/data/delta/

# Cron environment. Cron runs with a minimal PATH, so an nvm-installed node is
# not found automatically. scripts/off-cron.sh tries to detect it; set NODE_BIN
# explicitly to the output of `command -v node` if detection fails.
NODE_BIN=
OFF_LOG_DIR=/home/ingrefit/logs

# --- Community products -------------------------------------------------
# Products contributed by users when a barcode is in no Open Food Facts source.
# Set to false to stop storing and serving them entirely.
INGREFIT_COMMUNITY_ENABLED=true
# false puts new contributions in a review queue instead of publishing them.
INGREFIT_COMMUNITY_AUTOPUBLISH=true
# Where contributed front-photo thumbnails are written. Optional: defaults to
# ../ingrefit-data/community-images, a sibling of the checkout, which the app
# user already owns and which no deploy touches. Set it only to move the photos
# elsewhere (a mounted volume, a bigger disk).
# INGREFIT_COMMUNITY_IMAGE_DIR=
# Absolute base used to build image URLs handed to the app.
INGREFIT_PUBLIC_URL=https://ingrefit.com

# --- Admin ---------------------------------------------------------------
# Enables /admin. At least 8 characters. The session cookie is signed with
# INGREFIT_ENTITLEMENT_SECRET, so that must be set too.
INGREFIT_ADMIN_PASSWORD=
