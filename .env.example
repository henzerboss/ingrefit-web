# Gemini (same REST pattern as evsi.store)
GEMINI_API_KEY=replace-me
INGREFIT_GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite

# App update prompt. Raise LATEST when the new store build is available.
# Raise MINIMUM only when an old build must no longer be used.
INGREFIT_IOS_LATEST_VERSION=1.5.0
INGREFIT_IOS_MINIMUM_VERSION=1.0.0
INGREFIT_ANDROID_LATEST_VERSION=1.5.0
INGREFIT_ANDROID_MINIMUM_VERSION=1.0.0

# A comma-separated allowlist. The Expo app sends one as Bearer token.
INGREFIT_CLIENT_TOKENS=replace-with-a-long-random-token

# Required by Open Food Facts. Include a real contact address or web page.
OPEN_FOOD_FACTS_USER_AGENT=IngreFit/1.0 (https://ingrefit.com; support@evsi.store)

# RevenueCat secret key for server-side entitlement verification.
REVENUECAT_SECRET_API_KEY=sk_replace_me
REVENUECAT_ENTITLEMENT_ID=premium

# Optional legacy signed premium entitlements.
INGREFIT_ENTITLEMENT_SECRET=replace-with-at-least-32-random-bytes

# Expo Go/local preview only. This deliberately trusts the client plan; disable before distribution.
INGREFIT_ALLOW_DEMO_PREMIUM=false

# Optional Expo Go preview only. Use this same value as EXPO_PUBLIC_CLIENT_TOKEN while testing,
# then remove it before distributing the app.
INGREFIT_EXPO_GO_PREVIEW_TOKEN=
