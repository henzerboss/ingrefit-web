# Gemini (same REST pattern as evsi.store)
GEMINI_API_KEY=replace-me
INGREFIT_GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# A comma-separated allowlist. The Expo app sends one as Bearer token.
INGREFIT_CLIENT_TOKENS=replace-with-a-long-random-token

# Required by Open Food Facts. Include a real contact address or web page.
OPEN_FOOD_FACTS_USER_AGENT=IngreFit/1.0 (https://ingrefit.com; contact@ingrefit.com)

# Recommended for durable, atomic quotas in serverless production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signed premium entitlements from your billing webhook.
INGREFIT_ENTITLEMENT_SECRET=replace-with-at-least-32-random-bytes

# Local/preview only. Never enable in production.
INGREFIT_ALLOW_DEMO_PREMIUM=false
